            "stopOnEntry": true,
        },
        {
            "name": "Debug executable 'udp-server-thread'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=udp-server-thread",
                    "--package=cls"
                ]
            },
            "args": []
        },
                {
            "name": "Debug 'ecls'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=ecls",
                    "--package=ecls"
                ]
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug unit tests in library 'ecls'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=ecls"
                ]
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug unit shm_test in library 'ecls'",
