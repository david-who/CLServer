            "cargo": {
                "args": [
                    "run",
                    "--bin=udp-server-stm",
                    "--package=cls"
                ]
            },
            "args": [
                "127.0.0.1:8080",
                "0",
                "0"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true
        },
        {
            "name": "Debug executable 'udp-server-task'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=udp-server-task",
                    "--package=cls"
                ]
            },
            "args": [
                "127.0.0.1:8080",
