    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug 'tc-server'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=cls",    // should rename to tc-server
                    "--package=cls"
                ]
            },
            "args": [
                "run",
                "--verbose",
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "preLaunchTask": "rust: lib build"
        },
        {
            "name": "Debug unit tests in 'cls'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=cls",
                    "--package=cls"
                ]
            }
        },
        {
            "name": "Debug executable 'tcp-server-task'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=tcp-server-task",
                    "--package=cls"
                ]
            },
            "args": []
        },
        {
            "name": "Debug executable 'tcp-server-thread'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=tcp-server-thread",
                    "--package=cls"
                ]
            },
            "args": []
        },
        {
            "name": "Debug executable 'udp-client'",
